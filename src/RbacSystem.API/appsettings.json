{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "PasswordHashing": {
      "WorkFactor": 12
    }
  },
  "Auth": {
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "EmailVerificationTokenExpiryHours": 24,
    "OtpExpiryMinutes": 10
  }
}
